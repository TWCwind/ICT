# Main FastAPI service
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./01_软件杯主工程/backend/data
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# MCP service
MCP_HOST=127.0.0.1
MCP_PORT=8010

# Optional OpenAI-compatible model service. Keep real values only in .env.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://replace-with-your-model-endpoint.example.com
LLM_API_KEY=replace-with-local-secret
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT_SEC=60

